# Локальный .env (в git не коммитится).
# Для физического телефона backend доступен по IP машины в сети хот-спота телефона.
# Текущий адрес ноутбука в LAN (Ethernet): 192.168.0.158. Меняется при смене сети —
# сверять через ipconfig, иначе клиент молча не достучится до backend.
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.158:8000
